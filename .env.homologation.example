# CONTRACT/CI FIXTURE ONLY — NOT FOR DEPLOYMENT.
# Static credentials below exist only so configuration/Compose contracts are reproducible.
# Generate fresh secrets for any real homologation environment.
NODE_ENV=production
BRISABASE_DEPLOYMENT_MODE=self-hosted
BRISABASE_RELEASE=contract-20260828
BRISABASE_ENV_FILE=.env.homologation
VITE_DATA_SOURCE=api
BRISABASE_REGION=contract-1
BRISABASE_PRODUCTION_TIER=single-host
APP_DOMAIN=app.contract.invalid
STORAGE_DOMAIN=storage.contract.invalid
ACME_EMAIL=ops@contract.invalid
APP_URL=https://app.contract.invalid
API_URL=https://app.contract.invalid
STORAGE_PUBLIC_URL=https://storage.contract.invalid
REALTIME_PUBLIC_URL=wss://app.contract.invalid/realtime/v1/websocket
CORS_ALLOWED_ORIGINS=https://app.contract.invalid
POSTGRES_USER=brisabase_admin
POSTGRES_PASSWORD=CfgBootstrapDb_2026_5pQ8m2zN
DATABASE_APP_USER=brisabase_app
DATABASE_APP_PASSWORD=CfgApplicationDb_2026_7uK4w9xP
DATABASE_URL=postgresql://brisabase_app:CfgApplicationDb_2026_7uK4w9xP@postgres:5432/brisabase
DATABASE_MIGRATION_URL=postgresql://brisabase_app:CfgApplicationDb_2026_7uK4w9xP@postgres:5432/brisabase
DATABASE_SSL=false
REDIS_PASSWORD=CfgRedis_2026_8cR5n3vL
REDIS_URL=redis://:CfgRedis_2026_8cR5n3vL@redis:6379
REDIS_TLS=false
JWT_SECRET_PREVIOUS=
JWT_SECRET=ManagedJwt_2026_A9dF4gH7jK2mN5pQ8rT
AUTH_ENCRYPTION_KEY=ManagedAuth_2026_B8cE3fG6hJ1kM4nP7qS
AUTH_ENCRYPTION_KEY_PREVIOUS=
ADMIN_BOOTSTRAP_TOKEN=ci_bootstrap_2026_homologation_E6u5N8r3T9y2W4m7Q1p0
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
API_KEY_HASH_ALGORITHM=sha256
STORAGE_ENABLED=true
STORAGE_PROVIDER=minio
MINIO_ROOT_USER=cfgminioadmin
MINIO_ROOT_PASSWORD=CfgMinio_2026_9sT6b4yM
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cfgminioapp
S3_SECRET_KEY=CfgMinioApp_2026_4kR8v2mQ
S3_BUCKET=brisabase
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false
SMTP_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@contract.invalid
REALTIME_ENABLED=true
REALTIME_LOGICAL_REPLICATION_ENABLED=false
FUNCTIONS_ENABLED=true
FUNCTIONS_EXECUTOR_TOKEN=ci_functions_executor_contract_2026_J7mQ4vN9sR2xK6pT8wY3zL5c
FUNCTIONS_EXECUTOR_URL=http://functions-executor:3100
FUNCTIONS_RPC_CALLBACK_ORIGIN=http://brisabase:3000
FUNCTIONS_EXECUTOR_MAX_CONCURRENCY=4
FUNCTIONS_EXECUTION_TIMEOUT_MS=15000
FUNCTIONS_MEMORY_LIMIT_MB=128
FUNCTIONS_MAX_CONCURRENT_EXECUTIONS=4
# Syntactic digest fixture only; docker-compose.homologation.yml overrides this
# with a locally built disposable executor image for the contract runner.
FUNCTIONS_IMAGE=brisabase-functions:contract@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
BACKUP_ENABLED=true
BACKUP_ENCRYPTION_KEY=CfgBackup_2026_R4m8Q2v6K9p3T7x5N1w0Z8s2
BACKUP_STORAGE_BUCKET=brisabase-backups
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_RESTORE_CERTIFIED=false
PITR_ENABLED=false
PITR_PROVIDER=neon
BRISABASE_OPERATIONS_TOKEN=CfgOperations_2026_P6v2T8m4K9x3R7q5N1w0
BRISABASE_PITR_OPERATOR_TOKEN=CfgPitrOperator_2026_T5n9R3v7K2p6W4x8M1q0
HOSTING_ENABLED=true
HOSTING_CUSTOM_DOMAINS_ENABLED=true
HOSTING_CADDY_ASK_TOKEN=CfgHostingAsk_2026_H8q2M6v4R9t3K7x5N1p0
OBSERVABILITY_ENABLED=true
INFRASTRUCTURE_PREVIEW_ENABLED=false
ECOSYSTEM_PREVIEW_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
LOG_FORMAT=json
LOG_LEVEL=info

# Phase 3 application-auth options
AUTH_WEBAUTHN_RP_ID=
AUTH_WEBAUTHN_RP_NAME=BrisaBase
AUTH_WEBAUTHN_ORIGINS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Phase 7 AI Gateway: explicit public-host allowlist for OpenAI-compatible providers.
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com,openrouter.ai,api.groq.com,api.mistral.ai
ANALYTICS_RETENTION_DAYS=90
APP_QUALITY_RETENTION_DAYS=90
AI_USAGE_RETENTION_DAYS=90

# Phase 8 — commercial billing.
# Public beta stays free with BILLING_PROVIDER=disabled.
# After validation, use Paddle sandbox first, then switch to live credentials.
BILLING_PROVIDER=disabled
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_TEAM=
PADDLE_PRICE_ENTERPRISE=
ENTERPRISE_ENABLED=true
