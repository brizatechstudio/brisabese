# BrisaBase Hobby / Local
# Safe for local development only. Services bind to 127.0.0.1 in the base compose.
NODE_ENV=development
BRISABASE_DEPLOYMENT_PROFILE=hobby
BRISABASE_DEPLOYMENT_MODE=self-hosted
BRISABASE_PRODUCTION_TIER=single-host

# Optional host ports
BRISABASE_PORT=3000
BRISABASE_POSTGRES_PORT=5432
BRISABASE_REDIS_PORT=6379
BRISABASE_MINIO_PORT=9000
BRISABASE_MINIO_CONSOLE_PORT=9001
BRISABASE_SMTP_PORT=1025
BRISABASE_MAILPIT_PORT=8025

# Browser/API origin used by the local stack.
BRISABASE_PUBLIC_URL=http://localhost:3000
BRISABASE_REALTIME_PUBLIC_URL=ws://localhost:3000/realtime/v1/websocket
BRISABASE_CORS_ALLOWED_ORIGIN=http://localhost:3000

# Optional integrations remain disabled until credentials are supplied.
BILLING_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
