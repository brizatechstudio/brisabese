{
  email {$ACME_EMAIL}
  on_demand_tls {
    ask http://brisabase:3000/internal/hosting/domain-authorized?token={$HOSTING_CADDY_ASK_TOKEN}
  }
}

{$APP_DOMAIN} {
  encode zstd gzip
  reverse_proxy brisabase:3000
}

{$STORAGE_DOMAIN} {
  encode zstd gzip
  reverse_proxy brisabase:3000
}

# DNS-verified custom Hosting domains. Caddy asks BrisaBase before ACME issuance,
# preventing arbitrary-host certificate abuse.
https:// {
  tls {
    on_demand
  }
  encode zstd gzip
  reverse_proxy brisabase:3000
}
