# BrisaBase self-hosted production template.
# Generate strong independent values with: npm run secrets:generate
NODE_ENV=production
BRISABASE_DEPLOYMENT_MODE=self-hosted
BRISABASE_RELEASE=1.0.0
BRISABASE_ENV_FILE=.env
VITE_DATA_SOURCE=api
BRISABASE_REGION=local-1
BRISABASE_PRODUCTION_TIER=single-host

APP_DOMAIN=brisabase.example.com
STORAGE_DOMAIN=storage.brisabase.example.com
ACME_EMAIL=ops@example.com
APP_URL=https://brisabase.example.com
API_URL=https://brisabase.example.com
STORAGE_PUBLIC_URL=https://storage.brisabase.example.com
REALTIME_PUBLIC_URL=wss://brisabase.example.com/realtime/v1/websocket
CORS_ALLOWED_ORIGINS=https://brisabase.example.com

POSTGRES_USER=brisabase_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_BYTES
DATABASE_APP_USER=brisabase_app
DATABASE_APP_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_BYTES
DATABASE_URL=postgresql://brisabase_app:REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_BYTES@postgres:5432/brisabase
DATABASE_MIGRATION_URL=postgresql://brisabase_app:REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_BYTES@postgres:5432/brisabase
DATABASE_SSL=false
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=20

REDIS_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_BYTES
REDIS_URL=redis://:REPLACE_WITH_RANDOM_32_PLUS_BYTES@redis:6379
REDIS_TLS=false

JWT_SECRET_PREVIOUS=
JWT_SECRET=REPLACE_WITH_RANDOM_48_PLUS_BYTES
AUTH_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
AUTH_ENCRYPTION_KEY_PREVIOUS=
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
API_KEY_HASH_ALGORITHM=sha256
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

STORAGE_ENABLED=true
STORAGE_PROVIDER=minio
MINIO_ROOT_USER=REPLACE_WITH_ROOT_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_SECRET
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_WITH_APP_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_APP_SECRET
S3_BUCKET=brisabase
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# Nodemailer: port 587 normally uses STARTTLS with secure=false; use secure=true with port 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

REALTIME_ENABLED=true
REALTIME_LOGICAL_REPLICATION_ENABLED=false
FUNCTIONS_ENABLED=true
FUNCTIONS_EXECUTOR_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
FUNCTIONS_EXECUTOR_URL=http://functions-executor:3100
FUNCTIONS_RPC_CALLBACK_ORIGIN=http://brisabase:3000
FUNCTIONS_EXECUTOR_MAX_CONCURRENCY=10
FUNCTIONS_EXECUTION_TIMEOUT_MS=30000
FUNCTIONS_MEMORY_LIMIT_MB=256
FUNCTIONS_MAX_CONCURRENT_EXECUTIONS=10

BACKUP_ENABLED=true
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
BACKUP_STORAGE_BUCKET=brisabase-backups
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_CERTIFIED=false
PITR_ENABLED=false
PITR_PROVIDER=neon
NEON_PROJECT_ID=
NEON_API_KEY=
BRISABASE_OPERATIONS_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
BRISABASE_PITR_OPERATOR_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES

HOSTING_ENABLED=true
HOSTING_CUSTOM_DOMAINS_ENABLED=true
HOSTING_CADDY_ASK_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
OBSERVABILITY_ENABLED=true
OBSERVABILITY_LOG_RETENTION_DAYS=30
OBSERVABILITY_METRIC_RETENTION_DAYS=30
OBSERVABILITY_TRACE_RETENTION_DAYS=7
PROMETHEUS_ENABLED=true
INFRASTRUCTURE_PREVIEW_ENABLED=false
ECOSYSTEM_PREVIEW_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
LOG_FORMAT=json
LOG_LEVEL=info
TRUST_PROXY=1

# Resolve and append immutable digests before production deployment:
# node scripts/lock-container-images.cjs >> .env
NODE_IMAGE=node:22.18.0-bookworm-slim@sha256:REPLACE_WITH_REAL_DIGEST
POSTGRES_IMAGE=postgres:16.10-alpine@sha256:REPLACE_WITH_REAL_DIGEST
REDIS_IMAGE=redis:7.4.5-alpine@sha256:REPLACE_WITH_REAL_DIGEST
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:REPLACE_WITH_REAL_DIGEST
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z@sha256:REPLACE_WITH_REAL_DIGEST
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:REPLACE_WITH_REAL_DIGEST
FUNCTIONS_IMAGE=ghcr.io/example/brisabase-functions:1.0.0@sha256:REPLACE_WITH_REAL_DIGEST

# Phase 3 application-auth options
AUTH_WEBAUTHN_RP_ID=
AUTH_WEBAUTHN_RP_NAME=BrisaBase
AUTH_WEBAUTHN_ORIGINS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Phase 7 AI Gateway: explicit public-host allowlist for OpenAI-compatible providers.
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com,openrouter.ai,api.groq.com,api.mistral.ai
ANALYTICS_RETENTION_DAYS=90
APP_QUALITY_RETENTION_DAYS=90
AI_USAGE_RETENTION_DAYS=90

# Phase 8 — commercial billing.
# Public beta stays free with BILLING_PROVIDER=disabled.
# After validation, use Paddle sandbox first, then switch to live credentials.
BILLING_PROVIDER=disabled
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_TEAM=
PADDLE_PRICE_ENTERPRISE=
ENTERPRISE_ENABLED=true
