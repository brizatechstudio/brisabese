# BrisaBase local development defaults. These values are for an isolated local stack only.
NODE_ENV=development
VITE_DATA_SOURCE=api
BRISABASE_RUNTIME_MODE=local
BRISABASE_PUBLIC_URL=http://localhost:3000
BRISABASE_REALTIME_PUBLIC_URL=ws://localhost:3000/realtime/v1/websocket
BRISABASE_PORT=3000
BRISABASE_POSTGRES_PORT=5432
BRISABASE_REDIS_PORT=6379
BRISABASE_MINIO_PORT=9000
BRISABASE_MINIO_CONSOLE_PORT=9001
BRISABASE_SMTP_PORT=1025
BRISABASE_MAILPIT_PORT=8025

APP_URL=http://localhost:3000
API_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://brisabase:brisabase@localhost:5432/brisabase
DATABASE_MIGRATION_URL=postgresql://brisabase:brisabase@localhost:5432/brisabase
REDIS_URL=redis://localhost:6379
JWT_SECRET_PREVIOUS=
JWT_SECRET=brisabase-local-jwt-secret-with-at-least-thirty-two-bytes
AUTH_ENCRYPTION_KEY=brisabase-local-auth-encryption-with-at-least-thirty-two-bytes
AUTH_ENCRYPTION_KEY_PREVIOUS=
ADMIN_BOOTSTRAP_TOKEN=local-bootstrap-token-for-isolated-development-only

STORAGE_ENABLED=true
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=brisabase
S3_SECRET_KEY=brisabase-local-minio-development-only
S3_BUCKET=brisabase
S3_FORCE_PATH_STYLE=true
S3_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:3000

SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@brisabase.local

REALTIME_ENABLED=true
REALTIME_PUBLIC_URL=ws://localhost:3000/realtime/v1/websocket
REALTIME_LOGICAL_REPLICATION_ENABLED=false
FUNCTIONS_ENABLED=true
FUNCTIONS_EXECUTOR_URL=http://localhost:3100
FUNCTIONS_EXECUTOR_TOKEN=brisabase-local-functions-executor-token-with-more-than-thirty-two-bytes
OBSERVABILITY_ENABLED=true
BACKUP_ENABLED=true
BACKUP_STORAGE_BUCKET=brisabase-backups
INFRASTRUCTURE_PREVIEW_ENABLED=true
ECOSYSTEM_PREVIEW_ENABLED=true
LOG_FORMAT=pretty
LOG_LEVEL=info

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional AI provider used only by AI-specific features when enabled.
GEMINI_API_KEY=

# Phase 3 application-auth options
AUTH_WEBAUTHN_RP_ID=
AUTH_WEBAUTHN_RP_NAME=BrisaBase
AUTH_WEBAUTHN_ORIGINS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Phase 7 AI Gateway: explicit public-host allowlist for OpenAI-compatible providers.
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com,openrouter.ai,api.groq.com,api.mistral.ai
ANALYTICS_RETENTION_DAYS=90
APP_QUALITY_RETENTION_DAYS=90
AI_USAGE_RETENTION_DAYS=90

# Phase 8 — commercial billing.
# Public beta stays free with BILLING_PROVIDER=disabled.
# After validation, use Paddle sandbox first, then switch to live credentials.
BILLING_PROVIDER=disabled
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_TEAM=
PADDLE_PRICE_ENTERPRISE=
ENTERPRISE_ENABLED=true
