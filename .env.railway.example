# BrisaBase on Railway: one application service plus Railway PostgreSQL and Redis.
# Import these variables into the BrisaBase service. Do not commit the resulting
# Railway variables. Generate every REPLACE_WITH value independently with:
# npm run secrets:generate

NODE_ENV=production
BRISABASE_DEPLOYMENT_MODE=railway
VITE_DATA_SOURCE=api
BRISABASE_PRODUCTION_TIER=single-host
BRISABASE_REGION=railway
TRUST_PROXY=1

# Railway supplies PORT and RAILWAY_PUBLIC_DOMAIN. Leave the URLs empty to
# derive HTTPS, WSS, and CORS values from the generated public domain.
APP_URL=
API_URL=
STORAGE_PUBLIC_URL=
REALTIME_PUBLIC_URL=
CORS_ALLOWED_ORIGINS=

# Rename Postgres/Redis below if your Railway services have different names.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Leave empty unless a separate direct PostgreSQL URL is configured.
DATABASE_MIGRATION_URL=
DATABASE_SSL=false
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=20
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_TLS=false

JWT_SECRET=REPLACE_WITH_RANDOM_48_PLUS_BYTES
AUTH_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_48_PLUS_BYTES
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_48_PLUS_BYTES
BRISABASE_OPERATIONS_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_48_PLUS_BYTES
API_KEY_HASH_ALGORITHM=sha256
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# Optional modules are explicitly off for the first deployment.
STORAGE_ENABLED=false
SMTP_ENABLED=false
FUNCTIONS_ENABLED=false
BACKUP_ENABLED=false
PITR_ENABLED=false
HOSTING_ENABLED=false
HOSTING_CUSTOM_DOMAINS_ENABLED=false
OBSERVABILITY_ENABLED=false
PROMETHEUS_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
REALTIME_ENABLED=true
REALTIME_LOGICAL_REPLICATION_ENABLED=false
INFRASTRUCTURE_PREVIEW_ENABLED=false
ECOSYSTEM_PREVIEW_ENABLED=false

LOG_FORMAT=json
LOG_LEVEL=info
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com,openrouter.ai,api.groq.com,api.mistral.ai
ANALYTICS_RETENTION_DAYS=90
APP_QUALITY_RETENTION_DAYS=90
AI_USAGE_RETENTION_DAYS=90
BILLING_PROVIDER=disabled
PADDLE_ENVIRONMENT=sandbox
ENTERPRISE_ENABLED=true
