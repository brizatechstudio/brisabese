# BrisaBase Enterprise — external infrastructure profile
NODE_ENV=production
BRISABASE_DEPLOYMENT_PROFILE=enterprise
BRISABASE_DEPLOYMENT_MODE=managed
BRISABASE_PRODUCTION_TIER=ha
BRISABASE_RELEASE=1.0.1-beta.1
BRISABASE_REGION=enterprise-1
VITE_DATA_SOURCE=api

# Immutable application image produced by your release pipeline.
BRISABASE_IMAGE=ghcr.io/your-org/brisabase:1.0.1-beta.1@sha256:REPLACE_WITH_REAL_DIGEST
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:REPLACE_WITH_REAL_DIGEST

# Public endpoints. Corporate ingress/WAF may terminate TLS upstream.
APP_URL=https://brisabase.example.com
API_URL=https://brisabase.example.com
STORAGE_PUBLIC_URL=https://storage.brisabase.example.com
REALTIME_PUBLIC_URL=wss://brisabase.example.com/realtime/v1/websocket
CORS_ALLOWED_ORIGINS=https://brisabase.example.com
BRISABASE_BIND_ADDRESS=127.0.0.1
BRISABASE_PORT=3000
TRUST_PROXY=1

# External PostgreSQL. Use a dedicated application role and a direct migration endpoint.
DATABASE_URL=postgresql://brisabase_app:REPLACE_WITH_RANDOM_PASSWORD@postgres.example.net:5432/brisabase?sslmode=require
DATABASE_MIGRATION_URL=postgresql://brisabase_migrator:REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD@postgres-direct.example.net:5432/brisabase?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=50

# External Redis. Prefer rediss://. Rate limits and distributed coordination share this service.
REDIS_URL=rediss://:REPLACE_WITH_RANDOM_PASSWORD@redis.example.net:6380
REDIS_TLS=true
REDIS_PREFIX=brisabase

# Authentication and control-plane secrets. All values must be unique.
JWT_SECRET=REPLACE_WITH_RANDOM_48_PLUS_BYTES
JWT_SECRET_PREVIOUS=
AUTH_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
AUTH_ENCRYPTION_KEY_PREVIOUS=
ADMIN_BOOTSTRAP_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# External S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.).
STORAGE_ENABLED=true
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://s3.example.net
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_WITH_APP_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_RANDOM_APP_SECRET
S3_BUCKET=brisabase
S3_FORCE_PATH_STYLE=false
S3_USE_SSL=true

# Managed/HA Functions are opt-in and must be exposed as a separate HTTPS
# service (for example behind an internal corporate gateway/load balancer).
# The single-container executor bundled with Hobby/Self-Hosted is intentionally
# not presented as HA Enterprise infrastructure.
FUNCTIONS_ENABLED=false
FUNCTIONS_EXECUTOR_URL=
FUNCTIONS_EXECUTOR_TOKEN=
FUNCTIONS_RPC_CALLBACK_ORIGIN=
FUNCTIONS_EXECUTION_TIMEOUT_MS=30000
FUNCTIONS_MEMORY_LIMIT_MB=256
FUNCTIONS_MAX_CONCURRENT_EXECUTIONS=20
# When enabling Functions, use values such as:
# FUNCTIONS_EXECUTOR_URL=https://functions.example.com
# FUNCTIONS_EXECUTOR_TOKEN=<unique random 48+ byte secret>
# FUNCTIONS_RPC_CALLBACK_ORIGIN=https://brisabase.example.com

# Backup and recovery.
BACKUP_ENABLED=true
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
BACKUP_STORAGE_BUCKET=brisabase-backups
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_CERTIFIED=false
PITR_ENABLED=false
PITR_PROVIDER=neon
NEON_PROJECT_ID=
NEON_API_KEY=
BRISABASE_OPERATIONS_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES
BRISABASE_PITR_OPERATOR_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_48_PLUS_BYTES

# Realtime. Enable logical replication only after configuring a dedicated slot/publication.
REALTIME_ENABLED=true
REALTIME_LOGICAL_REPLICATION_ENABLED=false
REALTIME_LOGICAL_REPLICATION_SLOT=
REALTIME_LOGICAL_REPLICATION_PUBLICATION=
REALTIME_CDC_ORGANIZATION_ID=
REALTIME_CDC_PROJECT_ID=
REALTIME_CDC_ENVIRONMENT_ID=

# SMTP and strong authentication options.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# Nodemailer: port 587 normally uses STARTTLS with secure=false; use secure=true with port 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
AUTH_WEBAUTHN_RP_ID=
AUTH_WEBAUTHN_RP_NAME=BrisaBase
AUTH_WEBAUTHN_ORIGINS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Enterprise/security capabilities.
ENTERPRISE_ENABLED=true
HOSTING_ENABLED=true
HOSTING_CUSTOM_DOMAINS_ENABLED=false
HOSTING_CADDY_ASK_TOKEN=
OBSERVABILITY_ENABLED=true
OBSERVABILITY_LOG_RETENTION_DAYS=90
OBSERVABILITY_METRIC_RETENTION_DAYS=90
OBSERVABILITY_TRACE_RETENTION_DAYS=30
PROMETHEUS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
INFRASTRUCTURE_PREVIEW_ENABLED=false
ECOSYSTEM_PREVIEW_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
LOG_FORMAT=json
LOG_LEVEL=info

# Advanced platform / billing.
AI_PROVIDER_ALLOWED_HOSTS=api.openai.com,openrouter.ai,api.groq.com,api.mistral.ai
ANALYTICS_RETENTION_DAYS=90
APP_QUALITY_RETENTION_DAYS=90
AI_USAGE_RETENTION_DAYS=90
# Public beta stays free. Use Paddle Sandbox before any Live activation.
BILLING_PROVIDER=disabled
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_TEAM=
PADDLE_PRICE_ENTERPRISE=

# Optional bundled Caddy edge profile:
# docker compose --env-file .env.enterprise -f docker-compose.enterprise.yml --profile edge up -d
APP_DOMAIN=brisabase.example.com
STORAGE_DOMAIN=storage.brisabase.example.com
ACME_EMAIL=ops@example.com
